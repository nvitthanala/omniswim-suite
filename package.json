{
  "name": "omniswim-suite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @omniswim/shell",
    "build": "npm run build -w @omniswim/shell",
    "build:extension": "node extensions/swimcloud-companion/build.mjs",
    "start": "npm run start -w @omniswim/shell",
    "lint": "npm run lint:types && npm run lint:extension && npm run lint:eslint",
    "lint:types": "npm run lint --workspaces --if-present && npm run lint:tests",
    "lint:tests": "tsc --noEmit -p tests/tsconfig.json",
    "lint:extension": "tsc --noEmit -p extensions/swimcloud-companion/tsconfig.json",
    "lint:eslint": "eslint . --max-warnings 0",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "playwright test",
    "test:harness": "node scripts/run-harness.mjs",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:mutation": "stryker run",
    "migrate:sqlite": "tsx scripts/migrate-json-to-sqlite.mjs",
    "migrate:postgres": "tsx scripts/migrate-json-to-postgres.mjs",
    "test:roundtrip": "tsx scripts/test_sqlite_roundtrip.mjs",
    "test:roundtrip:pg": "tsx scripts/test_pg_roundtrip.mjs",
    "test:parity": "tsx scripts/test_persistence_parity.mjs",
    "test:scope": "tsx scripts/test_workspace_scope.mjs"
  },
  "dependencies": {
    "playwright-core": "1.61.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "react-dom": "^19.0.1",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
