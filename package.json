{
  "name": "omniswim-suite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "legacy/apps/*",
    "legacy/packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace legacy/apps/shell",
    "build": "npm run build --workspace legacy/apps/shell",
    "build:extension": "node legacy/extensions/swimcloud-companion/build.mjs",
    "start": "npm run start --workspace legacy/apps/shell",
    "lint": "npm run lint:types && npm run lint:eslint",
    "lint:legacy": "npm run lint --workspace legacy/apps/shell --workspace legacy/packages/db --workspace legacy/packages/manager --workspace legacy/packages/matrix --workspace legacy/packages/metrics --workspace legacy/packages/ui && npm run lint:extension && npm run lint:types:legacy && eslint legacy --max-warnings 0",
    "lint:types": "npm run lint --workspace @omniswim/core && npm run lint --workspace @omniswim/swimcloud && tsc --noEmit -p tests/tsconfig.json",
    "lint:types:legacy": "tsc --noEmit -p legacy/tests/tsconfig.json",
    "lint:tests": "tsc --noEmit -p tests/tsconfig.json",
    "lint:extension": "tsc --noEmit -p legacy/extensions/swimcloud-companion/tsconfig.json",
    "lint:eslint": "eslint . --ignore-pattern \"legacy/**\" --max-warnings 0",
    "test": "node scripts/run-tests.mjs",
    "test:legacy": "node legacy/scripts/run-tests.mjs && node scripts/check_skip_budget.mjs --config legacy/vitest.config.ts --budget legacy/tests/skip-budget.json",
    "test:e2e": "playwright test --config legacy/playwright.config.ts",
    "test:harness": "node legacy/scripts/run-harness.mjs",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:mutation": "stryker run",
    "migrate:sqlite": "tsx scripts/migrate-json-to-sqlite.mjs",
    "migrate:postgres": "tsx scripts/migrate-json-to-postgres.mjs",
    "test:roundtrip": "tsx scripts/test_sqlite_roundtrip.mjs",
    "test:roundtrip:pg": "tsx scripts/test_pg_roundtrip.mjs",
    "test:parity": "tsx scripts/test_persistence_parity.mjs",
    "test:scope": "tsx scripts/test_workspace_scope.mjs"
  },
  "dependencies": {
    "playwright-core": "1.61.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "react-dom": "^19.0.1",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
