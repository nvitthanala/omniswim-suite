# Checksum manifests are consumed by `sha256sum -c`, which treats a trailing
# CR as part of the filename. On a Windows checkout autocrlf would rewrite
# these to CRLF and the documented verification command would fail to find
# the file it just listed. Pin them to LF.
data/training/checksums.txt text eol=lf

# Source and text files are stored with LF and checked out with LF on every
# platform, so a Windows checkout with core.autocrlf=true shows no line-ending
# noise. Windows batch files keep CRLF because cmd.exe needs it.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
