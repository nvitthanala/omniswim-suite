{
  "manifest_version": 3,
  "name": "OmniSwim for SwimCloud",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "OmniSwim"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.swimcloud.com/meetsimulator/*"
      ],
      "js": [
        "sim-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.swimcloud.com/meetsimulator/*"
      ],
      "js": [
        "sim-overlay.js"
      ],
      "css": [
        "light.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dashboard.html"
      ],
      "matches": [
        "https://www.swimcloud.com/*"
      ],
      "use_dynamic_url": false
    }
  ]
}
