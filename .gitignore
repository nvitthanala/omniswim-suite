# Dependencies
node_modules/
**/node_modules/
.pnp/
.pnp.js

# Python virtual env / caches
venv/
**/venv/
.venv/
__pycache__/
**/__pycache__/
*.py[cod]
*.pyd
*.egg-info/

# Build output
dist/
**/dist/
build/
.vite/
**/.vite/
*.tsbuildinfo
*.local

# Local runtime data
uploads/
data/backups/
data/meets.json
# Pairing token for the SwimCloud capture routes: a per-machine secret that
# lets the browser extension write into the local capture store.
data/swimcloud-pairing-token.json
# Captured SwimCloud pages. Local-only by design — plans/2026-09-06/01-legal-and-access-strategy.md §4.
data/swimcloud-captures/
data/*.db
data/*.db-shm
data/*.db-wal
*.db
*.db-shm
*.db-wal

# Environment / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db

# Cursor / local agent
.cursor/
test-results/


# Training footage: third-party race video is not committed to this public repo.
# See legacy/data/training/MANIFEST.md for identity, provenance and checksums.
legacy/data/training/*
!legacy/data/training/MANIFEST.md
!legacy/data/training/checksums.txt
# The footage lived in data/training/ before 2026-10-25. Older clones may still
# hold it there; keep that path ignored too.
data/training/

# Conference results PDFs and text name every athlete at the meet: keep local.
data/relay-programs/sources/*.pdf
data/relay-programs/sources/*.txt

# Mutation testing (Stryker): sandbox copy of the repo and the JSON report
/.stryker-tmp/
/reports/

# Roster text exports name real swimmers: keep them local. They live in
# data/local-rosters/ (see docs/ONBOARDING.md, section 5). Tests fall back to
# the invented stand-ins in tests/fixtures/synthetic-rosters/ when absent.
data/local-rosters/
/hsuroster*.txt
/oburoster*.txt
/possible_hsu_*.txt
